# ==============================================================================
# Food Delivery Partner Portal - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit your actual .env file or sensitive secrets to version control.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partner_portal_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here
JPA_DDL_AUTO=update
SHOW_SQL=true

# Security Configuration (Future Phase / Weeks 5-6)
JWT_SECRET=your_super_secret_256_bit_jwt_key_here_must_be_long_and_secure
JWT_EXPIRATION_MS=86400000
