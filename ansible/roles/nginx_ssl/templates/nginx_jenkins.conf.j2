# ==============================================================================
# Nginx Ingress Configuration: {{ jenkins_domain_name }}
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# HTTP: Redirect all plain HTTP traffic to HTTPS (and serve ACME challenge)
server {
    listen 80;
    listen [::]:80;
    server_name {{ jenkins_domain_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: SSL Termination, Reverse Proxy to Jenkins container
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ jenkins_domain_name }};

    ssl_certificate /etc/letsencrypt/live/{{ jenkins_domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ jenkins_domain_name }}/privkey.pem;

    # SSL Hardening & Modern Ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Jenkins Security & Header Requirements
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Large upload sizes for Jenkins plugins & build artifacts
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:{{ jenkins_port | default(9090) }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket & CLI support for Jenkins
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Extended timeouts for long-running build console streaming
        proxy_connect_timeout 150s;
        proxy_send_timeout 150s;
        proxy_read_timeout 150s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
