# ==============================================================================
# Environment Configuration: {{ deployment_environment | default('staging') }}
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE={{ spring_profiles_active | default('staging') }}
SERVER_PORT={{ server_port | default(8080) }}

# Database Settings
DB_HOST=postgres
DB_PORT={{ db_port | default(5432) }}
DB_NAME={{ db_name | default('partner_portal_db') }}
DB_USERNAME={{ db_username | default('postgres') }}
DB_PASSWORD={{ db_password | default('1125') }}

# Security & JWT
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRATION_MS={{ jwt_expiration_ms | default(86400000) }}

# Observability & Logging
LOG_LEVEL={{ log_level | default('INFO') }}
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
